# Operation Nexus — environment variables
#
# Copy this file to `.env` (git-ignored) and adjust as needed:
#   cp .env.example .env         # `make bootstrap` does this for you
#
# Native `make api` loads the repo-root `.env`. Docker Compose also reads it.

# --- App ---
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
SESSION_SECRET=dev-session-secret-change-me

# Which scenario this deployment serves. Players type a team name and are
# dropped straight into it — there is no scenario picker in the UI.
SCENARIO_SLUG=vero_express

# --- Postgres (game state) ---
POSTGRES_DSN=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# --- Neo4j (case graph) ---
# Sessions run against AuraDB (neo4j+s://xxxxxxxx.databases.neo4j.io) so every
# team reads the same graph; the free tier pauses an idle instance after 3 days,
# so open the console before a session. The local URI below is the offline
# fallback and needs `make up-core` plus `make seed`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_dev_password

# --- Azure OpenAI (required only when AI_ENABLED=true) ---
# Investigator runtime is the mini deployment — not a flagship model.
AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_REASONING_DEPLOYMENT=gpt-5.6-sol
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AI_ENABLED=false
LANGSMITH_TRACING=false

# --- Frontend (Vite) — no secrets ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Origens de navegador autorizadas a chamar a API, separadas por vírgula.
# Ao publicar o frontend, acrescente a URL dele aqui ou toda chamada falha no CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# Infra-only — consumed by infra/compose.yaml
# ============================================================================
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
WEB_PORT=5173
